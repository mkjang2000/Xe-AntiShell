[Unit]
Description=Xe-AntiShell local monitoring web panel
Documentation=file:///usr/share/doc/xe-antishell/README.md
After=network.target sentineld.service
Wants=sentineld.service
ConditionPathExists=/etc/xe-antishell/web-auth.json

[Service]
Type=simple
User=xe-antishell-web
Group=xe-antishell
LoadCredential=web-auth:/etc/xe-antishell/web-auth.json
ExecStart=/usr/sbin/sentinel-web serve --listen 0.0.0.0:9088 --allow-non-loopback --socket /run/xe-antishell/sentineld.sock --auth-file %d/web-auth
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
